{
  "name": "prevalid-sdk",

  "version": "0.1.1",


  "description": "Prevalid is the decision system for AI. Official JavaScript/TypeScript SDK.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "prevalid",
    "decision-intelligence",
    "ai",
    "agents",
    "authorization",
    "sdk"
  ],
  "author": "Prevalid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/princeruhulofficial/prevalid-sdk.git"
  },
  "homepage": "https://www.prevalid.net/",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
